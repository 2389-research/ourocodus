# Minimal test agent for CI/smoketests
# This is a simple bash-based agent for testing container integration
FROM ubuntu:24.04

# Install minimal dependencies
# Note: This image is used for relay integration smoke tests that spawn
# containerized agents. Real agent images would include additional tooling
# (Claude Code, language runtimes, etc.) based on agent requirements.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    bash \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create a working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]

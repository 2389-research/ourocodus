# Agent container image with ACP runtime
# This image contains the ACP (Agent Client Protocol) binary for relay-managed agent execution
FROM ubuntu:24.04

# Install minimal dependencies
# Note: This image is used for relay integration smoke tests that spawn
# containerized agents. Real agent images would include additional tooling
# (Claude Code, language runtimes, etc.) based on agent requirements.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    bash \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built ACP binary (echo-agent for testing)
# In production, this would be the actual claude-code-acp binary
COPY bin/acp /usr/local/bin/acp
RUN chmod +x /usr/local/bin/acp

# Create a working directory
WORKDIR /workspace

# Environment variables required by ACP:
# - ANTHROPIC_API_KEY: API key for authentication
# - /workspace: Mounted workspace directory
# ACP communicates via stdio (JSON-RPC)

# Run ACP binary by default
ENTRYPOINT ["/usr/local/bin/acp"]
CMD ["--workspace", "/workspace"]
